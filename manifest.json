{
  "manifest_version": 3,
  "name": "SC Files",
  "version": "0.2.1",
  "description": "Dosyaları yükle ve Scratch yorumlarında paylaşılabilir bağlantı oluştur.",
  "action": {
    "default_title": "SC Files",
    "default_popup": "popup.html",
    "default_icon": { "16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png" }
  },
  "icons": { "16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png" },
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://0x0.st/*"]
}
